# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Two roles, deliberately.
#
#   DATABASE_URL            runtime. MUST be NOSUPERUSER / NOBYPASSRLS —
#                           superusers bypass row level security outright, which
#                           would make every isolation policy decorative.
#   MIGRATION_DATABASE_URL  schema owner. Runs Alembic, holds DDL rights.
#
# For Supabase: use the *session pooler* URI (port 5432), not the transaction
# pooler — RLS scoping relies on SET LOCAL, which needs a session-bound
# connection. Create a dedicated NOBYPASSRLS role there too; do not run the API
# as `postgres`.
DATABASE_URL=postgresql+asyncpg://app_user:app_password@db:5432/jobtracker
MIGRATION_DATABASE_URL=postgresql+asyncpg://jobtracker:jobtracker@db:5432/jobtracker

# --- Supabase Auth --------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Anon/publishable key — safe for the browser, used by the frontend.
SUPABASE_ANON_KEY=

# JWT verification. Supabase projects use one of two schemes:
#   * Newer projects: asymmetric (ECC/RSA) — leave SUPABASE_JWT_SECRET blank
#     and the backend fetches the JWKS from SUPABASE_URL automatically.
#   * Legacy projects: symmetric HS256 — paste the project JWT secret here.
# Setting the secret forces HS256; leaving it blank forces JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- LLM (Phase 2) --------------------------------------------------------
# LLM_PROVIDER selects which block below is used. All three speak the OpenAI
# dialect, so switching is a key, a base URL, and a model.
#
#   groq       free. 8,000 tokens/minute AND 200,000 tokens/day. Fastest
#              (~2-4s). The daily cap is the one that bites: backing off does
#              not help, you are finished until tomorrow. The fixed prefix
#              (22 tool schemas + system prompt) bills ~3,320 tokens a round,
#              so ~20-25 assistant messages exhaust a day.
#   gemini     free. Capped on requests rather than tokens — slower (~4-8s)
#              but far roomier for bulk work.
#   aicredits  paid, INR/UPI. No token ceiling at all: the limits are requests
#              per minute and your wallet. Roughly 10% over OpenAI list price.
#              Use this when the free tiers stop being enough.
#
# Whichever you pick must support strict `json_schema` structured output.
# On Groq that rules out everything except the gpt-oss and qwen families; the
# Llama chat models are retired from Groq entirely.
LLM_PROVIDER=groq

# console.groq.com > API Keys
GROQ_API_KEY=
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# aistudio.google.com/apikey — free, no card required
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# aicredits.in > Dashboard > API Keys. Prepaid INR wallet, no free allowance.
#
# Model ids are provider-prefixed and must come from `GET /v1/models` — the id
# used in their own docs example does not exist, and the catalogue's capability
# fields are wrong in places. gpt-4o-mini is the default because it was
# measured, not assumed: 9/10 on a tool-selection eval over the real 22-tool
# schema, strict json_schema honoured, and 475 completion tokens on the longest
# stored posting. gpt-5-mini scored 10/10 but spent 1,990 completion tokens on
# the same posting — reasoning tokens count against LLM_MAX_OUTPUT_TOKENS — at
# roughly eight times the price.
#
# Note this is a gateway, not a model provider, and it documents a fallback to
# an "aggregated provider pool". gpt-4o-mini echoes the exact id you asked for,
# which is the cheapest evidence you have of what actually served the request.
AI_CREDITS_API_KEY=
AICREDITS_EXTRACTION_MODEL=openai/gpt-4o-mini
AICREDITS_FAST_MODEL=openai/gpt-4o-mini

# --- Observability (Phase 2) ---------------------------------------------
# The endpoint is REGIONAL and is not optional. A key issued in one region is
# refused by another with a bare 403 that says nothing about geography, which
# looks exactly like an invalid key. Copy it from the same LangSmith setup
# screen as the key.
#   US    https://api.smith.langchain.com
#   EU    https://eu.api.smith.langchain.com
#   APAC  https://apac.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-job-tracker

# --- Embeddings (Phase 3) -------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Frontend (Vite only exposes VITE_* to the browser)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000
