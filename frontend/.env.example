# Copy to .env.local. Vite only exposes variables prefixed with VITE_ to the
# browser, and only reads env files at startup — restart the dev server after
# editing.

VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>
VITE_API_BASE_URL=http://localhost:8000
