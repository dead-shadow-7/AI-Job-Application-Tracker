// Rubric cases: judgement only, with the evidence supplied by hand.
//
// No database, no embeddings, no retrieval. That separation is the point — a
// requirement whose evidence retrieval missed *should* score as unmet under
// rule 1, so an eval that ran retrieval could not tell a judgement failure from
// an index failure. Retrieval quality is measured separately and for free in
// tests/test_matching_retrieval.py.
//
// `requirements` is a list of [requirement, [evidence passages]]. An empty
// evidence list is rendered to the model as "(nothing relevant found in the
// resume)" — which is the case rule 1 exists for, and the reason `unevidenced`
// cases are hard-gated.
//
// Bands are 0.3 wide. The rubric is worth 15 of 100 points, so a tighter band
// would be finer resolution than the output can act on.

// --- Rule 1: absence of evidence is absence ---------------------------------
{"id": "unevidenced-is-a-gap", "rule": "1", "gate": "hard", "title": "Streaming Engineer", "company": "Northwind", "unevidenced": "Kafka", "requirements": [["5+ years of Kafka in production", []], ["Strong Python", ["Built and maintained Python services on FastAPI for four years."]]], "matched_skills": ["Python"], "missing_skills": ["Kafka"], "score_band": [0.2, 0.6]}
{"id": "no-inferring-a-framework-from-a-language", "rule": "1", "gate": "hard", "title": "Django Developer", "company": "Bluepeak", "unevidenced": "Django", "requirements": [["Production Django experience", []], ["Python fundamentals", ["Five years writing Python, mostly data pipelines and CLI tooling."]]], "matched_skills": ["Python"], "missing_skills": ["Django"], "score_band": [0.2, 0.6]}
{"id": "no-inferring-orchestration-from-cloud", "rule": "1", "gate": "hard", "title": "Platform Engineer", "company": "Halden", "unevidenced": "Kubernetes", "requirements": [["Operating Kubernetes at scale", []], ["AWS experience", ["Ran production workloads on AWS EC2 and RDS for three years."]]], "matched_skills": ["AWS"], "missing_skills": ["Kubernetes"], "score_band": [0.2, 0.6]}
{"id": "everything-unevidenced-scores-low", "rule": "1", "gate": "hard", "title": "Embedded Engineer", "company": "Aldergate", "unevidenced": "C++", "requirements": [["Strong C++", []], ["RTOS experience", []], ["Hardware debugging", []]], "matched_skills": [], "missing_skills": ["C++", "RTOS"], "score_band": [0.0, 0.3]}

